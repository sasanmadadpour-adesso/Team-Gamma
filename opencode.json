{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AI-AGENT-GUIDE.md"],
  "mcp": {
    "cds-mcp": {
      "type": "local",
      "command": ["npx", "-y", "@cap-js/mcp-server"],
      "enabled": true
    },
    "ui5": {
      "type": "local",
      "command": ["npx", "-y", "@ui5/mcp-server"],
      "enabled": true
    },
    "fiori-mcp": {
      "type": "local",
      "command": ["npx", "--yes", "@sap-ux/fiori-mcp-server@1.15.12", "fiori-mcp"],
      "enabled": true
    }
  },
  "provider": {
    "adesso-ai-hub": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "adesso AI Hub",
      "options": {
        "baseURL": "https://adesso-ai-hub.3asabc.de/v1"
      },
      "models": {
        "gpt-5.6-sol": {},
        "claude-opus-5": {},
        "gpt-5.6-luna": {},
        "claude-sonnet-5": {},
        "qwen3-coder-480b": {},
        "qwen-3.6-35b-sovereign": {},
        "deepseek-v4-flash-sovereign": {}
      }
    }
  },
  "agent": {
    "plan": {
      "model": "adesso-ai-hub/gpt-5.6-sol"
    },
    "build": {
      "model": "adesso-ai-hub/gpt-5.6-luna"
    }
  }
}